{
  "name": "ai-news",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:categories && npm run test:digest && npm run test:benchmarks && npm run test:http && npm run test:browser && npm run test:admin-auth",
    "test:categories": "node --experimental-strip-types tests/category-classification.mjs",
    "test:digest": "node --experimental-strip-types tests/daily-digest.mjs",
    "test:benchmarks": "node --experimental-strip-types tests/benchmarks.mjs",
    "test:http": "node tests/http.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:admin-auth": "node --experimental-strip-types tests/admin-authorization.mjs",
    "test:news-review": "node tests/news-review-http.mjs",
    "test:discovery": "node --experimental-strip-types tests/search-discovery.mjs",
    "discover:google-news": "node --experimental-strip-types scripts/discover-google-news.mjs",
    "test:pilot": "node --experimental-strip-types tests/news-review-pilot.mjs",
    "pilot:google-news": "node --experimental-strip-types scripts/run-google-news-pilot.mjs",
    "benchmarks:refresh": "node scripts/fetch-models.mjs",
    "benchmarks:audit-sources": "node --experimental-strip-types scripts/verify-benchmark-sources.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "summarize:backfill": "node --env-file=.env.local scripts/backfill-summaries.mjs",
    "images:backfill": "node --env-file=.env.local scripts/backfill-images.mjs"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/analytics": "^2.0.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

