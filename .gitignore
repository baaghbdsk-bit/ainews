# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/shots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log


# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local secret copy (do not commit)
.cron-secret.txt
dev-out.txt

.vscode/
tests/_*

# Agent skill packs generated by `npm install -g ui-ux-pro-max-cli`
/.agents/skills/
/.opencode/skills/

# Agent scratch artifacts
/scratch/

# CSS restructure baseline snapshots (build artifacts, not sources).
# Must stay ignored: Tailwind's Oxide scanner auto-detects sources from the
# project root and honours .gitignore. An unignored .orig snapshot here is
# scanned as raw text, so class-like words inside CSS comments leak into the
# utility candidate set and emit phantom rules.
.baseline-css/

# Scratch test and inspection scripts
tests/capture-*.mjs
tests/test-*.mjs
tests/inspect-*.mjs
